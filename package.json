    "type": "module",
    "devDependencies": {
        "@types/node": "^24.10.0",
        "electron": "^44.4.5",
        "electron-builder": "^26.15.3",
        "typescript": "^5.9.3",
        "vite": "^8.3.1",
        "vite-plugin-electron": "^1.1.2",
        "vite-plugin-electron-renderer": "^1.0.0"
