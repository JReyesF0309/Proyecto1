{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "npm: install",
            "type": "process",
            "command": "C:\\Program Files\\nodejs\\npm.cmd",
            "args": ["install"],
            "problemMatcher": []
        },
        {
            "label": "npm: start",
            "type": "process",
            "command": "C:\\Program Files\\nodejs\\npm.cmd",
            "args": ["run", "start"],
            "dependsOn": "npm: install",
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "^((?!).*)$",
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "ready in"
                }
            }
        },
        {
            "label": "npm: electron",
            "type": "process",
            "command": "C:\\Program Files\\nodejs\\npm.cmd",
            "args": ["run", "electron"],
            "dependsOn": "npm: install",
            "options": {
                "env": {
                    "REMOTE_DEBUGGING_PORT": "9222"
                }
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "^((?!).*)$",
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "ready in"
                }
            }
        },
        {
            "label": "Construir release con Electron",
            "type": "process",
            "command": "C:\\Program Files\\nodejs\\npm.cmd",
            "args": ["run", "release:electron"],
            "dependsOn": "npm: install",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "terminar vite",
            "type": "process",
            "command": "echo",
            "args": ["${input:terminateVite}"],
            "problemMatcher": []
        },
        {
            "label": "terminar electron",
            "type": "process",
            "command": "echo",
            "args": ["${input:terminateElectron}"],
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "terminateVite",
            "type": "command",
            "command": "workbench.action.tasks.terminate",
            "args": "npm: start"
        },
        {
            "id": "terminateElectron",
            "type": "command",
            "command": "workbench.action.tasks.terminate",
            "args": "npm: electron"
        }
    ]
}